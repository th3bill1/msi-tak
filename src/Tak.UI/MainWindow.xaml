<Window x:Class="Tak.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Tak.UI"
        mc:Ignorable="d"
        Title="Tak - Board Game AI" Height="800" Width="1000"
        Background="LightGray">
    
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="600"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Board -->
        <StackPanel Grid.Column="0" Margin="10">
            <TextBlock Text="Game Board" FontSize="18" FontWeight="Bold" Margin="0,0,0,10"/>
            <UniformGrid x:Name="BoardGrid" Columns="6" Rows="6" Width="500" Height="500"/>
        </StackPanel>

        <!-- Control Panel -->
        <StackPanel Grid.Column="1" Margin="10" VerticalAlignment="Stretch" Background="White">
            <TextBlock Text="Game Controls" FontSize="16" FontWeight="Bold" Margin="0,0,0,15"/>

            <!-- Game Setup -->
            <TextBlock Text="Setup" FontSize="12" FontWeight="Bold" Margin="0,0,0,5"/>
            
            <TextBlock Text="Board Size:" FontSize="11" Margin="0,5,0,2"/>
            <ComboBox x:Name="BoardSizeCombo" Height="25" Margin="0,0,0,10">
                <ComboBoxItem Content="4x4" IsSelected="False"/>
                <ComboBoxItem Content="5x5" IsSelected="True"/>
                <ComboBoxItem Content="6x6" IsSelected="False"/>
            </ComboBox>

            <TextBlock Text="Your Color:" FontSize="11" Margin="0,5,0,2"/>
            <ComboBox x:Name="PlayerColorCombo" Height="25" Margin="0,0,0,10">
                <ComboBoxItem Content="White" IsSelected="True"/>
                <ComboBoxItem Content="Black" IsSelected="False"/>
            </ComboBox>

            <TextBlock Text="Opponent AI:" FontSize="11" Margin="0,5,0,2"/>
            <ComboBox x:Name="OpponentCombo" Height="25" Margin="0,0,0,10">
                <ComboBoxItem Content="Random" IsSelected="False"/>
                <ComboBoxItem Content="Heuristic" IsSelected="True"/>
                <ComboBoxItem Content="UCT" IsSelected="False"/>
                <ComboBoxItem Content="RAVE" IsSelected="False"/>
                <ComboBoxItem Content="Progressive Widening" IsSelected="False"/>
            </ComboBox>

            <Button x:Name="NewGameBtn" Content="Start New Game" Height="35" Margin="0,0,0,15" 
                    Click="NewGameBtn_Click" Background="LightBlue" FontSize="11" FontWeight="Bold"/>

            <!-- Game Status -->
            <TextBlock Text="Status" FontSize="12" FontWeight="Bold" Margin="0,15,0,5"/>
            <TextBlock x:Name="StatusText" Text="Click 'Start New Game' to begin" Margin="0,0,0,10" 
                       TextWrapping="Wrap" FontSize="10"/>

            <TextBlock Text="Current Player: " FontSize="11" Margin="0,0,0,2"/>
            <TextBlock x:Name="CurrentPlayerText" Text="-" FontSize="11" FontWeight="Bold" Margin="0,0,0,10"/>

            <TextBlock Text="Move History:" FontSize="12" FontWeight="Bold" Margin="0,10,0,5"/>
            <ListBox x:Name="MoveHistoryList" Height="200" Margin="0,0,0,10" FontSize="9"/>

            <Button x:Name="UndoBtn" Content="Undo Last Move" Height="30" Margin="0,0,0,10" 
                    Click="UndoBtn_Click" Background="LightCoral" FontSize="10" IsEnabled="False"/>

            <TextBlock Text="Piece Selection:" FontSize="12" FontWeight="Bold" Margin="0,10,0,5"/>
            <ComboBox x:Name="PieceTypeCombo" Height="25" Margin="0,0,0,10">
                <ComboBoxItem Content="Place Flat" IsSelected="True"/>
                <ComboBoxItem Content="Place Wall" IsSelected="False"/>
                <ComboBoxItem Content="Place Capstone" IsSelected="False"/>
                <ComboBoxItem Content="Move Stack" IsSelected="False"/>
            </ComboBox>

            <TextBlock x:Name="HelpText" Text="Select a piece type, then click the board to place or move." 
                       FontSize="9" TextWrapping="Wrap" Margin="0,0,0,10" Foreground="Gray"/>
        </StackPanel>
    </Grid>
</Window>
